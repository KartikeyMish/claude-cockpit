#!/usr/bin/env python3
"""ccx: claude-cockpit launcher, dashboard and session manager. See `ccx help`."""

import os
import sys

if sys.version_info < (3, 9):
    sys.exit("ccx needs Python 3.9 or newer")

# Resolve through the ~/.local/bin symlink to find the repo's lib/.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from cockpit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
