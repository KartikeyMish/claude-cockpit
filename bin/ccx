#!/usr/bin/env python3
"""ccx: claude-cockpit launcher, dashboard and session manager. See `ccx help`."""

import os
import sys

# Keep this check parseable by any Python (no f-strings): it has to run before the
# package, which needs 3.9, is imported. 3.9 is what macOS ships as /usr/bin/python3.
MIN_PYTHON = (3, 9)
if sys.version_info < MIN_PYTHON:
    sys.exit(
        "ccx needs Python %d.%d or newer, but %s is Python %s.\n"
        "Put a newer python3 first on PATH (macOS: `xcode-select --install` provides one, "
        "or `brew install python`), then run ccx again."
        % (MIN_PYTHON[0], MIN_PYTHON[1], sys.executable or "python3", "%d.%d.%d" % tuple(sys.version_info[:3]))
    )

# Resolve through the ~/.local/bin or Homebrew symlink to find the bundled lib/.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from cockpit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
